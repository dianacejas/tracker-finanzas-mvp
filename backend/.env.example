# Plantilla de variables de entorno — copia este archivo a .env
# El archivo .env está ignorado por Git y jamás se versiona.

DEBUG=True
SECRET_KEY=clave_secreta_de_solo_desarrollo
ALLOWED_HOSTS=localhost,127.0.0.1

# Desarrollo local: sqlite:///db.sqlite3
# PostgreSQL:    postgres://usuario:password@localhost:5432/finance_db
DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Vida útil del par de tokens JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
